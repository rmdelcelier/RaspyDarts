msgid "Description-Kapital"
msgstr "Gana el Kapital más alto.\n"
"\n"
"Complete contratos únicos cada ronda.\n"
"-----\n"
"Contratos:\n"
"\n"
"K: Puntos máximos en 3 dardos.\n"
"TRIP: Acierta al menos 1 triple.\n"
"DOUB: Acierta al menos 1 doble.\n"
"KOLR: Acierta 3 colores de segmento diferentes en 3 dardos.\n"
"57: Anota 57 puntos en 1-3 dardos.\n"
"KKOT: Acierta 3 números vecinos (el Bull es comodín).\n"
"SUIT: Acierta 3 números secuenciales (el Bull es comodín).\n"
"20, 19, 18, 17, 16, 15, 14: Acierta el número asignado al menos una vez.\n"
" "

######## KILLER ######

msgid "Description-Killer"
msgstr "¡Elimina a tus oponentes antes de que te eliminen!\n"
"Conviértete en Asesino (Killer) anotando al menos 5 puntos en tu número asignado.\n"
"\n"
"Pierdes el estado de Killer si tu puntuación cae por debajo de 5.\n"
"-----\n"
"Alcanzar 5 puntos otorga el estado de Killer.\n"
"Caer por debajo de 5 elimina el estado de Killer.\n"
"\n"
"Caer a -1 puntos elimina a un jugador.\n"
"\n"
"Si NO eres Killer:\n"
"- Aciertas tu propio número = +puntos.\n"
"- Aciertas el número del oponente = -puntos.\n"
"\n"
"Si eres KILLER:\n"
"- Aciertas el número del oponente = -puntos del oponente.\n"
"- Aciertas tu propio número = -puntos propios.\n"
" "

