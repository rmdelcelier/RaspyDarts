######## ROUTINE ######

msgid "Description-Routine"
msgstr "Mejora tus habilidades en los dardos completando a diario\n"
"los 35 ejercicios.\n"
"\n"
"1: Check-out 32 en 1 dardo - Acierta D16.\n"
"2: Check-out 40 en 3 dardos - Termina en Doble.\n"
"3: Check-out 50 en 3 dardos - No se permite Bull.\n"
"4: Check-out 60 en 2 dardos - Termina en Doble.\n"
"5: Check-out 80 en 2 dardos - Termina en Doble.\n"
"6: Check-out 120 en 3 dardos - Termina en Doble.\n"
"7: Check-out 110 en 6 dardos - Termina en Doble.\n"
"8: Check-out 121 en 6 dardos - Termina en Doble.\n"
"9: Check-out 180 en 9 dardos - Termina en Doble.\n"
"10: Check-out 201 en 12 dardos - Termina en Doble.\n"
"11: Check-out 301 en 12 dardos - Termina en Doble.\n"
"12: Check-out 401 en 10 dardos - Termina en Doble.\n"
"13: Check-out 501 en 15 dardos - Termina en Doble.\n"
"14: Acierta 1 Simple, 1 Doble, 1 Bull en 3 dardos.\n"
"15: Acierta 2 Bulls dobles (DB) en 6 dardos.\n"
"16: Acierta 3 Bulls en 9 dardos.\n"
"-----\n"
"17: Anota 10 pts acertando bull (SB=1, DB=2) en 10 dardos.\n"
"18: Anota 15 pts acertando bull (SB=1, DB=2) en 15 dardos.\n"
"19: Acierta 3 números idénticos en 3 dardos.\n"
"20: Acierta 2 Dobles diferentes en 3 dardos.\n"
"21: Acierta D20 y D1 en 6 dardos.\n"
"22: Acierta D20, D19 y D18 en orden en 9 dardos.\n"
"23: Acierta 3 Dobles diferentes en 9 dardos.\n"
"24: Acierta D16, D8, D4 y D2 en orden en 12 dardos.\n"
"25: Acierta D3, D5, D7, D9 y D11 en 15 dardos.\n"
"26: Acierta 2 Triples diferentes en 3 dardos.\n"
"27: Acierta S10, D10 y T10 en 3 dardos.\n"
"28: Acierta S20, T20 y D20 en 3 dardos.\n"
"29: Acierta 3 Simples, 2 Dobles, 1 Triple en el mismo número en 6 dardos.\n"
"30: Acierta 3x 1 número y 1 bull en 4 dardos.\n"
"31: Acierta 3x 2 números y 1 bull en 7 dardos.\n"
"32: Acierta 3 Triples diferentes en 9 dardos.\n"
"33: Acierta Triple 20 3 veces en 9 dardos.\n"
"34: Acierta 3x T20, 3x T19 y 3x T18 en 9 dardos.\n"
"35: Finisher progresivo (+5 por éxito)\n"
" "

msgid "Routine-max_retries"
msgstr "Reintentos máx por ejercicio"

msgid "Routine-start_drill"
msgstr "Seleccionar ejercicio"

msgid "Routine-teste"
msgstr "Probar un solo ejercicio"

msgid "Routine-nb_repetition"
msgstr "Repeticiones máximas"

######## SABOTAGE #########

msgid "Description-Sabotage"
msgstr "Anote el máximo de puntos mientras sabotea las puntuaciones\n"
"de sus oponentes.\n"
"\n"
"Anota lo más alto posible en tu 3er dardo (por defecto);\n"
"aumenta tus puntos y deduce los de los oponentes.\n"
"\n"
"Gana la puntuación más alta tras 10 rondas.\n"
"\n"
"Opciones:\n"
"- Dardos: Total de ronda dividido por 3 deducido de los oponentes.\n"
"- Aleatorio: Deduce puntos de un oponente aleatorio.\n"
"-----\n"
"Anote el máximo de puntos mientras sabotea las puntuaciones\n"
"de sus oponentes.\n"
"\n"
"Anota lo más alto posible en tu 3er dardo (por defecto);\n"
"aumenta tus puntos y deduce los de los oponentes.\n"
"\n"
"En caso de fallo, pulse el botón nextplayer para omitir un dardo.\n"
"\n"
"Gana la puntuación más alta tras 10 rondas.\n"
"\n"
"Opciones:\n"
"- Dardos: Total de ronda dividido por 3 deducido de los oponentes.\n"
"- Aleatorio: Deduce puntos de un oponente aleatorio.\n"
