######## SWITCH_OFF #########

msgid "Description-Switch"
msgstr "Turn off all LEDs by hitting corresponding numbers.\n"
"Be careful not to turn them back on by hitting them again.\n"
"\n"
"Turn off all LEDs to win, or achieve highest score after 12 rounds.\n"
"\n"
"Options:\n"
"- Rounds: Number of rounds.\n"
"- Numeric: Display in numerical order.\n"
"-----\n"
"- SINGLE hit: Toggles number LED.\n"
"- DOUBLE hit: Toggles number LED and next LED.\n"
"- TRIPLE hit: Toggles number LED, next LED, and previous LED.\n"
"\n"
"- SB hit (if off): Turns on SB.\n"
"- SB hit (if on): Turns on DB.\n"
"- SB hit (if SB and DB on): Turns off SB.\n"
"- DB hit (if SB and DB off): Turns on DB and SB.\n"
"- DB hit (if DB on and SB off): Turns on SB.\n"
"- DB hit (if SB and DB on): Turns off DB.\n"
" "

msgid "Switch-numerique"
msgstr "Numerical order"

######## TARGET #########

msgid "Description-Target"
msgstr "Score requested target in fewest darts.\n"
"\n"
"All scores (30 to 60) hit in 1 dart.\n"
"\n"
"- Target hit in 1 dart = 3 points.\n"
"- Target hit in 2 darts = 2 points.\n"
"- Target hit in 3 darts = 1 point.\n"
"\n"
"First player to 10 points (default) wins.\n"
"\n"
"Options:\n"
"- Score: Points required to win.\n"
"-----\n"
"Score requested target in fewest darts.\n"
"\n"
"All scores (30 to 60) hit in 1 dart.\n"
"\n"
"- Target hit in 1 dart = 3 points.\n"
"- Target hit in 2 darts = 2 points.\n"
"- Target hit in 3 darts = 1 point.\n"
"\n"
"First player to 10 points (default) wins.\n"
"\n"
"Options:\n"
"- Score: Points required to win.\n"
" "

msgid "Target-score"
msgstr "Points to win"

msgid "Target-simple50"
msgstr "SB worth 50 points"

msgid "Target-winscore"
msgstr "Winning points"

######## TENNIS ######

msgid "Description-Tennis"
msgstr "Each player serves during their turn.\n"
"\n"
"Win game by hitting target segment;\n"
"otherwise opponent scores points.\n"
"\n"
"Options:\n"
"- Sets: 1 to 3 sets to win.\n"
"- Side: Net in vertical position.\n"
"-----\n"
"On 1st shot, select preferred segment.\n"
"- DOUBLE hit = Win game instantly.\n"
"- TRIPLE hit = Score 3 points.\n"
"- SINGLE hit = Score 1 point.\n"
"\n"
"After 1st shot, hit segment to score:\n"
"- SINGLE = 1 point.\n"
"- DOUBLE = 2 points.\n"
"- TRIPLE = 3 points.\n"
"\n"
"During TIEBREAK, winner shots earn 1 point only\n"
"even on doubles or triples.\n"
"\n"
"Unlimited darts allowed to finish game.\n"
"\n"
"Player winning most sets wins match.\n"
" "

msgid "Tennis-max_players"
msgstr "2 or 4 (Team)"

msgid "Tennis-service"
msgstr "Serving"

msgid "Tennis-set"
msgstr "Sets to win"

msgid "Tennis-cote"
msgstr "Vertical net"

