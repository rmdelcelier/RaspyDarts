######## SIMON ######

msgid "Description-Simon"
msgstr "Repeat sequence in order.\n"
"\n"
"Memorize and repeat the color sequence displayed by the game.\n"
"\n"
"One color added to sequence each round.\n"
"\n"
"Player who reproduces longest sequence wins.\n"
"\n"
"Number of darts matches sequence length.\n"
"-----\n"
"Player repeating longest sequence wins.\n"
"\n"
"Options:\n"
"- Rounds: Maximum number of rounds.\n"
"- Bonus darts: Allowed mistakes per round.\n"
" "

msgid "Simon-nb_bonus_darts"
msgstr "Number of bonus darts"

