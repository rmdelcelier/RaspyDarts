######## BOB'S 27 ######

msgid "Bob27-name"
msgstr "Bob '27"

msgid "Description-Bob27"
msgstr "Game invented by former pro player Bob Anderson.\n"
"\n"
"Each player starts with 27 points. The goal is to\n"
