msgid "Slider-bull"
msgstr "Finish on Bull"

msgid "Slider-double"
msgstr "Play doubles"

msgid "Slider-triple"
msgstr "Play triples"

msgid "Slider-jump"
msgstr "Skip numbers"

######## SNOOKER ######

msgid "Description-Snooker"
msgstr "Snooker ported to dartboard.\n"
"\n"
"Hit red ball then color ball.\n"
"\n"
"Hitting wrong ball causes a foul,\n"
"awarding 4 bonus points to opponents.\n"
"\n"
"Highest score wins.\n"
"-----\n"
"Hit red ball then color ball.\n"
"\n"
"Missing correct ball commits a foul, forfeiting turn and\n"
"giving 4 points to all opponents.\n"
"\n"
"Once all reds are pocketed, clear color balls in ascending order.\n"
"\n"
"- Yellow = 2 pts, Green = 3 pts, Brown = 4 pts, Blue = 5 pts,\n"
"- Pink = 6 pts, Black = 7 pts.\n"
"\n"
"Options:\n"
"- Rounds: Max rounds.\n"
"- Red balls: Red ball count (15 max).\n"
"- Random red: Red balls placed randomly.\n"
"- Shared table: Play on single shared table.\n"
" "

